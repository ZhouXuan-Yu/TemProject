{
  "version": 1,
  "provider": "local",
  "retrieval": {
    "enabled": true,
    "max_results": 4,
    "max_chars": 6000
  },
  "runtime": {
    "max_record_chars": 12000,
    "max_file_bytes": 2097152,
    "dedupe_cache_size": 5000
  },
  "promotion": {
    "auto_write_curated_markdown": false,
    "require_review_for_decisions": true,
    "require_review_for_wiki": true,
    "corrections_are_high_priority": true
  },
  "security": {
    "redact_secrets": true,
    "store_full_tool_responses": false
  }
}
